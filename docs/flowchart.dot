digraph G {
  rankdir=TB; dpi=170; nodesep=0.45; ranksep=0.45;
  node [fontname="Helvetica", fontsize=11, style="filled", color="#1f3a5f", fillcolor="#eef3fa"];
  edge [fontname="Helvetica", fontsize=10, color="#44546a"];

  start [label="START", shape=oval, fillcolor="#cfe8cf"];
  init  [label="Health = 100\nScore = 0", shape=box];
  loop  [label="Health > 0?", shape=diamond, fillcolor="#fff4cc"];
  menu  [label="Forest menu\n1 Cave | 2 River | 3 Quit\nRead choice", shape=parallelogram];
  valid [label="Choice is 1, 2 or 3?", shape=diamond, fillcolor="#fff4cc"];
  inv   [label="Print invalid-choice message\nAsk again", shape=box, fillcolor="#fde2e2"];
  sel   [label="Which choice?", shape=diamond, fillcolor="#fff4cc"];
  cave  [label="CAVE\nDamage = random 10-40\nHealth = max(0, Health - Damage)", shape=box];
  alive [label="Health > 0?", shape=diamond, fillcolor="#fff4cc"];
  key   [label="Add 20 points\nPrint key message", shape=box];
  river [label="RIVER\nAdd 50 points\nHealth unchanged", shape=box];
  quit  [label="Show final score and health", shape=box];
  over  [label="Print Game Over and final score", shape=box, fillcolor="#fde2e2"];
  end   [label="END", shape=oval, fillcolor="#f4cfcf"];

  start -> init -> loop;
  loop -> menu [label="Yes"];
  loop -> over [label="No"];
  menu -> valid;
  valid -> inv [label="No"];
  inv -> menu;
  valid -> sel [label="Yes"];
  sel -> cave [label="1"];
  sel -> river [label="2"];
  sel -> quit [label="3"];
  cave -> alive;
  alive -> key [label="Yes"];
  alive -> loop [label="No"];
  key -> loop;
  river -> loop;
  quit -> end;
  over -> end;
}

